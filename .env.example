# Environment variables read by the code. Copy to .env and fill in values.

# OpenAI API key (services/openai_service.py, seed/seed_question_bank.py,
# seed/seed_csc301_questions.py)
OPENAI_API_KEY=

# Firebase service-account JSON, as a single-line string (services/firebase_service.py).
# If unset, the app falls back to ./serviceAccountKey.json.
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated browser origins allowed to call the API (main.py),
# e.g. https://your-web-app.example,http://localhost:8081
# Unset means no browser origin is allowed. Native mobile apps are not
# affected by CORS.
ALLOWED_ORIGINS=
